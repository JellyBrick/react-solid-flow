{
  "name": "@jellybrick/react-solid-flow",
  "version": "1.2.0",
  "license": "MIT",
  "scripts": {
    "build": "tsdown --dts",
    "test": "vitest --run --coverage",
    "lint": "eslint .",
    "prepack": "npm run lint && npm run test && npm run build"
  },
  "type": "module",
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.mjs",
  "types": "./dist/lib.d.cts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.mts",
        "default": "./dist/lib.mjs"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./babel": {
      "import": {
        "types": "./dist/babel.d.mts",
        "default": "./dist/babel.mjs"
      },
      "require": {
        "types": "./dist/babel.d.cts",
        "default": "./dist/babel.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "useResource-examples.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JellyBrick/react-solid-flow.git"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@eslint/js": "^9.18.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "react-solid-flow",
    "react-control-flow",
    "control-flow",
    "for",
    "react-for",
    "forEach",
    "react-foreach",
    "ErrorBoundary",
    "portal",
    "async",
    "await",
    "fetch",
    "promise",
    "react",
    "reactjs",
    "solid",
    "solidjs",
    "hook",
    "hooks",
    "useAsync",
    "useFetch",
    "usePromise",
    "use-async",
    "use-fetch",
    "use-promise"
  ]
}
